<mxfile host="app.diagrams.net" type="device"><diagram id="petition-architecture" name="Architecture"><mxGraphModel dx="2010" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1200" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h1" value="1&amp;nbsp;&amp;nbsp;Build once (notebooks, offline)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#1A1A1A;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="8" width="900" height="40" as="geometry"/></mxCell><mxCell id="src" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;Data source&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;petition.parliament.uk&lt;br&gt;JSON API + CSV&lt;br&gt;Open Government&lt;br&gt;Licence v3.0&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="240" height="180" as="geometry"/></mxCell><mxCell id="collect" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;Collect&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;collect.py&lt;br&gt;128,077 petitions&lt;br&gt;snapshot 25 Sep 2026&lt;br&gt;checked by SHA-256&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="240" height="180" as="geometry"/></mxCell><mxCell id="clean" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;02 Cleaning&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;allow-list of fields&lt;br&gt;7 labels, 886 dropped&lt;br&gt;clean text, gold links&lt;br&gt;leakage check&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="580" y="200" width="250" height="180" as="geometry"/></mxCell><mxCell id="split" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;04 Split + pools&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;split by decision time&lt;br&gt;train / val / test&lt;br&gt;open-petition pool&lt;br&gt;for every decision&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="870" y="200" width="240" height="180" as="geometry"/></mxCell><mxCell id="eda" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;03 EDA&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;describes the data, no model choice:&lt;br&gt;classes over time · text length · words&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="580" y="450" width="530" height="150" as="geometry"/></mxCell><mxCell id="tfidf" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;TF-IDF + LinearSVM&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;05 · baseline&lt;br&gt;val macro-F1 0.445&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F7BD6;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1160" y="40" width="340" height="130" as="geometry"/></mxCell><mxCell id="distil" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;DistilRoBERTa&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;colab_gpu (T4) · fine-tuned&lt;br&gt;val macro-F1 0.556&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F7BD6;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1160" y="190" width="340" height="130" as="geometry"/></mxCell><mxCell id="bm25" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;BM25&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;06 · baseline&lt;br&gt;val Recall@5 0.804&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FCEEE6;strokeColor=#E8692D;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1160" y="340" width="340" height="130" as="geometry"/></mxCell><mxCell id="minilm" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;MiniLM vectors + hybrid&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;colab_gpu vectors · 07&lt;br&gt;val Recall@5 0.922 (hybrid)&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FCEEE6;strokeColor=#E8692D;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1160" y="490" width="340" height="130" as="geometry"/></mxCell><mxCell id="fusion" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;08 Fusion&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;temperature + Platt&lt;br&gt;similarity features&lt;br&gt;logistic regression&lt;br&gt;review threshold&lt;br&gt;0.75&lt;br&gt;val macro-F1 0.607&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1550" y="190" width="230" height="270" as="geometry"/></mxCell><mxCell id="frozen" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;Frozen&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;settings in&lt;br&gt;frozen_config&lt;br&gt;+ models/&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1820" y="180" width="170" height="140" as="geometry"/></mxCell><mxCell id="test" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;09 Test&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;used once&lt;br&gt;6,182 petitions&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1820" y="380" width="170" height="140" as="geometry"/></mxCell><mxCell id="lg_a" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#E8F1FB;strokeColor=#2F7BD6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="458" width="36" height="30" as="geometry"/></mxCell><mxCell id="lg_a_t" value="Task A: outcome classification" style="text;html=1;align=left;verticalAlig