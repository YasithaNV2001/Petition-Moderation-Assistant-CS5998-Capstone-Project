)&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FCEEE6;strokeColor=#E8692D;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="600" y="890" width="320" height="130" as="geometry"/></mxCell><mxCell id="hybrid" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;Hybrid retrieval&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;BM25 + MiniLM&lt;br&gt;top-5 open petitions&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FCEEE6;strokeColor=#E8692D;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="600" y="1040" width="320" height="130" as="geometry"/></mxCell><mxCell id="fmodel" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;Fusion model&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;predicted outcome&lt;br&gt;+ calibrated&lt;br&gt;confidence&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="990" y="790" width="240" height="180" as="geometry"/></mxCell><mxCell id="flag" value='&lt;div style="font-size:18px;font-weight:bold;margin-bottom:16px;"&gt;Review flag&lt;/div&gt;&lt;div style="font-size:15px;line-height:1.6;"&gt;confidence &amp;lt; 0.75&lt;br&gt;= look closer&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F1EF;strokeColor=#555555;strokeWidth=2;verticalAlign=top;spacingTop=18;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1290" y="790" width="230" height="180" as="geom